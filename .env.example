# Optional settings. Copy to .env if you need any of them:  cp .env.example .env

# Run without the local LLM (no GPU required). Retrieval, trends, statistics and
# semantic search still work; only the generated executive summary is skipped.
# NURALIS_LLM_ENABLED=false

# Use a different model: a Hugging Face causal-LM id (loaded in 8-bit, needs CUDA)
# or a path to a local .gguf file (runs through llama.cpp, works on CPU).
# NURALIS_LLM_MODEL=EleutherAI/gpt-j-6B

# Alternative config file
# NURALIS_CONFIG=config/main_config.yaml

# Hugging Face token — only needed for gated or private models
# HF_TOKEN=

# llama.cpp tuning (GGUF models only)
# LLAMA_CPP_THREADS=8
# LLAMA_CPP_GPU_LAYERS=0

# Launcher ports
# BACKEND_PORT=8010
# FRONTEND_PORT=5050
